              <calculation class='tableau' formula='IF SUM([CY Sales (copy)_0681446711738384]) = WINDOW_MAX(SUM([CY Sales (copy)_0681446711738384]))&#13;&#10;THEN SUM([CY Sales (copy)_0681446711738384])&#13;&#10;ELSEIF SUM([CY Sales (copy)_0681446711738384]) = WINDOW_MIN(SUM([CY Sales (copy)_0681446711738384]))&#13;&#10;THEN SUM([CY Sales (copy)_0681446711738384])&#13;&#10;END'>
